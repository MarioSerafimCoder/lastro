{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastro-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/integration/*", "/health"],
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "lastro.marioserafim.com.br", "custom_domain": true },
  ],
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "services": [{ "binding": "STUDIO", "service": "studio-editorial" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lastro",
      "database_id": "b3ab414c-bdcd-4348-a942-2cb153bc9f1b",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *", "2-57/5 * * * *", "17,47 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "BRAIN_DRIVE_ENABLED": "true",
    "BRAIN_DRIVE_FREE_CONFIRMED": "true",
    "BRAIN_DRIVE_CLIENT_ID": "352771654042-p6g4ad3dnlbofbfofvsda2f0rfivcvv8.apps.googleusercontent.com",
    "BRAIN_DRIVE_REDIRECT_URI": "https://lastro.marioserafim.com.br/api/jarvis/drive/oauth/callback",
    "ALLOWED_ORIGIN": "https://lastro.marioserafim.com.br",
    "ALLOWED_FETCH_HOSTS": "feeds.feedburner.com,feeds2.feedburner.com,www.smashingmagazine.com,api.openalex.org,alistapart.com,www.creativeboom.com,brasil.uxdesign.cc,plau.substack.com,designnotes.blog.gov.uk,baixacultura.org,internetlab.org.br,escoladedados.org,creativecommons.org",
    "INGEST_ENABLED": "true",
    "SYNOPSIS_ENABLED": "true",
    "SYNOPSIS_REQUIRED": "true",
    "INTEGRATION_ENABLED": "true",
    "STUDIO_ORIGIN": "https://studio.marioserafim.com.br",
    "CRM_ORIGIN": "https://crm.marioserafim.com.br",
    "ANALYTICS_ENABLED": "true",
    "GA4_PROPERTY_ID": "560757639",
    "GOOGLE_OAUTH_CLIENT_ID": "111592653976-ant88deecg3ucvpof8e2d2h062lfsv1k.apps.googleusercontent.com",
  },
}
