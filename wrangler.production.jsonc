{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastro-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lastro",
      "database_id": "b3ab414c-bdcd-4348-a942-2cb153bc9f1b",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://lastro-api.marioserafim-da.workers.dev",
    "ALLOWED_FETCH_HOSTS": "feeds.feedburner.com,www.smashingmagazine.com,api.openalex.org",
    "INGEST_ENABLED": "false",
  },
}
