{
  "name": "lastro-hub-criativo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run web:build && wrangler dev --local --ip 127.0.0.1 --port 8787 --test-scheduled",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "npm run web:build && wrangler deploy --dry-run --outdir dist/worker",
    "verify": "npm run typecheck && npm run web:typecheck && npm test && npm run build",
    "format": "prettier --write src packages tests scripts examples docs apps/web *.json *.jsonc *.md",
    "format:check": "prettier --check src packages tests scripts examples docs apps/web *.json *.jsonc *.md",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:typecheck": "tsc --noEmit --project apps/web/tsconfig.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261019.1-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  }
}
